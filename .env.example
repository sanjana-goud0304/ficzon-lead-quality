# Copy to .env and fill in. NEVER commit .env.

# Optional: only needed if you pull data from the MySQL source yourself.
DB_HOST=<your-db-host>
DB_PORT=3306
DB_NAME=project_sales
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# Salt used to hash contact identifiers into a non-reversible grouping key.
# Use any long random string; keep it out of version control.
FICZON_HASH_SALT=<long-random-string>
